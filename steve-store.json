{
  "store": 1,
  "name": {
    "en": "Steve extensions",
    "zh-CN": "Steve 官方插件库"
  },
  "plugins": [
    {
      "id": "openlark",
      "name": {
        "en": "Feishu / Lark as you",
        "zh-CN": "飞书（以你的身份）"
      },
      "summary": {
        "en": "Read and write Feishu / Lark as the signed-in person, not as a bot, through an openlark-gateway you run yourself.",
        "zh-CN": "通过你自己运行的 openlark-gateway，以登录者本人而不是机器人的身份读写飞书。"
      },
      "kind": "channel",
      "version": "0.1.0",
      "contract": 1,
      "entry": "bin/steve-plugin-openlark",
      "homepage": "https://github.com/Infranite/steve-extensions/tree/main/plugins/openlark",
      "config": [
        {
          "key": "gateway_url",
          "label": {
            "en": "Gateway address",
            "zh-CN": "网关地址"
          },
          "hint": {
            "en": "wss://… or https://…; ws:// and http:// only for a gateway on this machine",
            "zh-CN": "wss://… 或 https://…；ws:// 和 http:// 只用于本机上的网关"
          },
          "required": true
        },
        {
          "key": "gateway_token",
          "label": {
            "en": "Gateway credential",
            "zh-CN": "网关凭据"
          },
          "hint": {
            "en": "Created with `openlark-gateway cred create`; its scopes decide what Steve may do",
            "zh-CN": "用 `openlark-gateway cred create` 创建；它的权限范围决定 Steve 能做什么"
          },
          "secret": true,
          "required": true
        }
      ],
      "artifacts": {
        "aarch64-apple-darwin": {
          "url": "https://github.com/Infranite/steve-extensions/releases/download/openlark-v0.1.0/openlark-0.1.0-aarch64-apple-darwin.tar.gz",
          "sha256": "38eabab015f58ff0091d65a7f914d617570d9caa7f85c045cd2212185ae48867"
        },
        "x86_64-unknown-linux-gnu": {
          "url": "https://github.com/Infranite/steve-extensions/releases/download/openlark-v0.1.0/openlark-0.1.0-x86_64-unknown-linux-gnu.tar.gz",
          "sha256": "43ea7da869cae31cb489183eba1c9aceea995b17332755b7c3e4c306465c7e4c"
        }
      }
    }
  ]
}
